Package: STBench
Type: Package
Title: Normalisation and Benchmarking for Spatial Transcriptomics
Version: 0.1.0
Authors@R:
    person(
        given = "Lahiru",
        family = "Boyagoda",
        role = c("aut", "cre"),
        email = "lahiru.s.sandaruwan@gmail.com",
        comment = c(ORCID = "0009-0003-1367-2279")
